<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:icon="@drawable/ic_radio"
        android:theme="@style/RadioTheme"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Read-only station artwork for Android Auto's lists. -->
        <provider
            android:name=".LogoProvider"
            android:authorities="uk.lukeet.mg4radio.logos"
            android:exported="true" />

        <service
            android:name=".RadioMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
